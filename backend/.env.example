# Copy this file to .env on each VM (dev/qa/prod) and fill in real values.
# NEVER commit the real .env file to GitHub.

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (one DB per environment)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/registration_dev?retryWrites=true&w=majority

# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
